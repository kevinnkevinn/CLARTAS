# =============================================================================
# CLARTAS environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in REAL values for local development.
# NEVER commit `.env.local`. Only variables prefixed with NEXT_PUBLIC_ are
# exposed to the browser/mobile client. All other keys are server-only secrets.
# =============================================================================

# --- Supabase ---------------------------------------------------------------
# Project URL + anon key are safe for the client. Service role key is SERVER ONLY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers (SERVER ONLY) ---------------------------------------------
# If these are empty, AI routes run in safe MOCK mode (no external calls).
FAL_KEY=
REPLICATE_API_TOKEN=

# --- Paddle (payments) ------------------------------------------------------
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Optional: sandbox | production
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_PRICE_PREMIUM=
NEXT_PUBLIC_PADDLE_PRICE_ENTERPRISE=

# Optional: Paddle customer portal URL for manage billing
NEXT_PUBLIC_PADDLE_BILLING_PORTAL_URL=

# --- Resend (transactional email) -------------------------------------------
RESEND_API_KEY=
# Verified sender, e.g. "CLARTAS <noreply@yourdomain.com>"
RESEND_FROM_EMAIL=

# --- Make.com (automation webhooks) -----------------------------------------
MAKE_WEBHOOK_URL=

# --- App ---------------------------------------------------------------------
# Public base URL of the deployed web app. Mobile builds call this for APIs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth Web Client ID (login Google di web + Android native)
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Store URLs (opsional, untuk PWA related_applications)
NEXT_PUBLIC_ANDROID_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.clartas.app
NEXT_PUBLIC_IOS_APP_STORE_URL=https://apps.apple.com/app/clartas/id0000000000

# Demo mode: skip login, unlimited credits, browser-based AI processing
NEXT_PUBLIC_DEMO_MODE=true

# Comma-separated list of admin emails granted access to /admin.
ADMIN_EMAILS=
